#!/bin/bash
# Pre-commit: quick checks on staged files. Install: cp scripts/pre-commit .git/hooks/pre-commit
set -e
ROOT="$(git rev-parse --show-toplevel)"
[ -f "$ROOT/.git/MERGE_HEAD" ] || [ -d "$ROOT/.git/rebase-merge" ] && exit 0
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
FAILED=0

if echo "$STAGED" | grep -qE '\.rs$|Cargo\.(toml|lock)$'; then
  echo "rust: fmt + clippy"
  (cd "$ROOT" && cargo fmt --all --check && cargo clippy --workspace --all-targets --quiet -- -D warnings) || FAILED=1
fi
if echo "$STAGED" | grep -qE '\.py$'; then
  for f in $(echo "$STAGED" | grep -E '\.py$'); do python3 -m py_compile "$ROOT/$f" || FAILED=1; done
fi
if echo "$STAGED" | grep -qE '^\.github/workflows/.*\.ya?ml$'; then
  if command -v actionlint >/dev/null; then
    for f in $(echo "$STAGED" | grep -E '^\.github/workflows/'); do actionlint -shellcheck= -pyflakes= "$ROOT/$f" || FAILED=1; done
  else
    echo "actionlint not installed (brew install actionlint); skipping workflow lint"
  fi
fi
if echo "$STAGED" | grep -qE '^infra/.*\.tf$'; then
  (cd "$ROOT/infra/hetzner" && terraform fmt -check -recursive) || FAILED=1
fi

[ "$FAILED" = 0 ] && exit 0
echo "pre-commit failed (git commit --no-verify to skip)"; exit 1
