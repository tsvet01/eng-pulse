DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://<ref>.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated
PIPELINE_SERVICE_TOKEN=<openssl rand -hex 32>
ADMIN_EMAIL=you@example.com
NOTIFY_PUSH_ENABLED=false
# Required when NOTIFY_PUSH_ENABLED=true; key is the .p8 file, base64 on one line.
APNS_KEY_BASE64=<base64 -i AuthKey.p8 | tr -d '\n'>
APNS_KEY_ID=<10-character key id>
APNS_TEAM_ID=<10-character team id>
